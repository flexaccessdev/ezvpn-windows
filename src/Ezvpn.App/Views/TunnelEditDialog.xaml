<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Ezvpn.App.Views.TunnelEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <ScrollViewer>
        <StackPanel Spacing="12" MinWidth="420">

            <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error"
                     IsClosable="False" Title="Invalid profile" />

            <TextBox x:Name="NameBox" Header="Name" PlaceholderText="e.g. work" />

            <TextBox x:Name="NodeIdBox" Header="Server node id"
                     PlaceholderText="iroh endpoint id" TextWrapping="Wrap" AcceptsReturn="False" />

            <Grid ColumnSpacing="8" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="KeyBox" Grid.Column="0" Header="Auth key (required)"
                          HorizontalAlignment="Stretch" DisplayMemberPath="Name"
                          PlaceholderText="Choose a key…"
                          SelectionChanged="OnKeySelectionChanged" />
                <Button x:Name="ManageKeysButton" Grid.Column="1" Content="Manage keys…"
                        VerticalAlignment="Bottom" Click="OnManageKeys" />
            </Grid>

            <TextBlock x:Name="PublicKeyText" TextWrapping="Wrap" FontFamily="Consolas"
                       Visibility="Collapsed" IsTextSelectionEnabled="True"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <InfoBar x:Name="MissingKeyBar" IsOpen="False" Severity="Warning" IsClosable="False"
                     Title="Auth key missing"
                     Message="The auth key this profile used is no longer in the key list. Pick a key before saving." />

            <TextBox x:Name="RelayBox" Header="Relay URLs (optional, comma-separated)"
                     PlaceholderText="https://relay.example.com"
                     TextWrapping="Wrap" AcceptsReturn="False"
                     TextChanged="OnRelayBoxTextChanged" />

            <PasswordBox x:Name="RelayTokenBox" Header="Relay token (optional, custom relays only)"
                         IsEnabled="False" />

            <TextBox x:Name="RoutesBox" Header="IPv4 routes (CIDR, comma-separated)"
                     TextWrapping="Wrap" AcceptsReturn="False"
                     PlaceholderText="10.0.0.0/8, 192.168.0.0/16" />

            <TextBox x:Name="Routes6Box" Header="IPv6 routes (CIDR, comma-separated)"
                     TextWrapping="Wrap" AcceptsReturn="False"
                     PlaceholderText="fd00::/8" />

            <NumberBox x:Name="MaxAttemptsBox" Header="Max reconnect attempts (blank = unlimited)"
                       SpinButtonPlacementMode="Compact" Minimum="1" />

            <CheckBox x:Name="AutoReconnectCheck" Content="Reconnect automatically" IsChecked="True" />

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
