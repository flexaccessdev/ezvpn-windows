<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Ezvpn.App.Views.TunnelEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    Opened="OnOpened"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <ScrollViewer x:Name="FormScroller">
        <StackPanel Spacing="14" MinWidth="460" Padding="0,0,12,0">

            <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error"
                     IsClosable="False" Title="Can't save yet" />

            <TextBox x:Name="NameBox" Header="Name" PlaceholderText="e.g. work" />

            <TextBox x:Name="NodeIdBox" Header="Server node id"
                     PlaceholderText="The server's iroh endpoint id"
                     Description="Printed by the server when it starts."
                     FontFamily="Consolas"
                     TextWrapping="Wrap" AcceptsReturn="False" />

            <StackPanel Spacing="6">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="KeyBox" Grid.Column="0" Header="Auth key"
                              HorizontalAlignment="Stretch" DisplayMemberPath="Name"
                              PlaceholderText="Choose a key…"
                              SelectionChanged="OnKeySelectionChanged" />
                    <Button x:Name="ManageKeysButton" Grid.Column="1" Content="Manage keys…"
                            VerticalAlignment="Bottom" Click="OnManageKeys" />
                </Grid>

                <TextBlock x:Name="PublicKeyText" TextWrapping="Wrap" FontFamily="Consolas"
                           Visibility="Collapsed" IsTextSelectionEnabled="True"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <InfoBar x:Name="NoKeysBar" IsOpen="False" Severity="Informational" IsClosable="False"
                     Title="No auth keys yet"
                     Message="Use Manage keys… to create one, then add its public key to the server's authorized_keys file." />

            <InfoBar x:Name="MissingKeyBar" IsOpen="False" Severity="Warning" IsClosable="False"
                     Title="Auth key missing"
                     Message="The key this profile used was removed from the key list. Pick a key before saving." />

            <TextBox x:Name="RoutesBox" Header="IPv4 routes"
                     TextWrapping="Wrap" AcceptsReturn="False"
                     PlaceholderText="10.0.0.0/8, 192.168.0.0/16"
                     Description="CIDRs sent through the tunnel, comma-separated. The server's gateway is always reachable." />

            <TextBox x:Name="Routes6Box" Header="IPv6 routes"
                     TextWrapping="Wrap" AcceptsReturn="False"
                     PlaceholderText="fd00::/8" />

            <!-- Rarely changed settings, folded away so a new profile is three
                 fields. Opens itself when a profile already uses any of them. -->
            <Expander x:Name="AdvancedExpander" Header="Advanced"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="14">
                    <TextBox x:Name="RelayBox" Header="Custom relay URLs"
                             PlaceholderText="https://relay.example.com"
                             Description="Comma-separated. Leave blank to use the default iroh relays; otherwise list every relay the server is configured with, since the client finds the server only through these."
                             TextWrapping="Wrap" AcceptsReturn="False"
                             TextChanged="OnRelayBoxTextChanged" />

                    <!-- The token and QUIC address discovery are custom-relay
                         settings. With no relay URLs each is disabled, unless it
                         holds a non-default value: then it stays usable so it can
                         be reset, and Save refuses it (see UpdateCustomRelayFieldsEnabled). -->
                    <PasswordBox x:Name="RelayTokenBox" Header="Relay token"
                                 PlaceholderText="Only with custom relays"
                                 IsEnabled="False"
                                 PasswordChanged="OnCustomRelayFieldChanged" />

                    <StackPanel Spacing="2">
                        <CheckBox x:Name="QuicAddrDiscoveryCheck" Content="QUIC address discovery"
                                  IsChecked="True" IsEnabled="False"
                                  Checked="OnCustomRelayFieldChanged" Unchecked="OnCustomRelayFieldChanged" />
                        <TextBlock TextWrapping="Wrap"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Turn off when the relays are behind a Cloudflare Tunnel or another HTTP-only front, which cannot serve it and otherwise delay each connect by up to 3 s. It applies to all the relays or none." />
                    </StackPanel>

                    <CheckBox x:Name="AutoReconnectCheck" Content="Reconnect automatically when the connection drops"
                              IsChecked="True"
                              Checked="OnAutoReconnectChanged" Unchecked="OnAutoReconnectChanged" />

                    <NumberBox x:Name="MaxAttemptsBox" Header="Give up after this many attempts"
                               PlaceholderText="No limit"
                               SpinButtonPlacementMode="Compact" Minimum="1" />
                </StackPanel>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
